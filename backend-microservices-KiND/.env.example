# Copy this file to .env in the repo root before running `docker compose up`.
# docker-compose.yml reads these via ${VAR} interpolation and passes them
# into the relevant containers — none of them are committed with real values.

# ─── Auth ───────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-string

# "production" turns on the refresh-token cookie's `secure` flag (HTTPS-only) — see
# auth-service/utils/cookies.js. Leave as "development" for local http:// work, or the
# refresh-token cookie won't be sent by the browser at all.
NODE_ENV=development

# Comma-separated frontend origins allowed to make credentialed requests (i.e. ones that can
# send/receive the refresh-token cookie). Both the storefront (5174) and admin (5173) need to
# be listed — a request from an origin not in this list gets the cookie silently dropped by
# the browser even if every other part of the auth flow is correct.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Dev/test convenience ONLY — enables POST /api/auth/admin-register, which lets anyone who
# knows this code create a staff or admin account without an existing admin's approval.
# Leave this blank/unset (the default) to disable that endpoint entirely — it always 403s
# when this var isn't set. Never set this in a real deployment.
ADMIN_REGISTRATION_CODE=

# ─── Google OAuth (auth-service) ───────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth Client ID
# (type: Web application). Must match the client ID configured in the
# frontend's VITE_GOOGLE_CLIENT_ID — they verify against the same audience.
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ─── Stripe (payment-service) ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─── Cloudinary (auth-service + product-service image uploads) ────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── SMTP (notification-service) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LetsPlayPro <no-reply@letsplaypro.com>"
