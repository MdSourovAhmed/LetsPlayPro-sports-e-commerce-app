# PORT=3005
# MONGO_URI=mongodb://localhost:27017/payment-service
# RABBITMQ_URL=amqp://localhost

# # Internal Docker network URL for product-service — used to compute the
# # authoritative charge amount server-side. Never trust a client-sent total.
# PRODUCT_SERVICE_URL=http://localhost:3002

# # Stripe — secret key stays server-side only, never send it to the frontend.
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# # From the Stripe CLI (`stripe listen --forward-to localhost:3005/api/payments/webhook`)
# # in development, or the Dashboard's webhook endpoint settings in production.
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret



PORT=3005
MONGO_URI=mongodb://localhost:27017/payment-service
RABBITMQ_URL=amqp://localhost

# Internal Docker network URL for product-service — used to compute the
# authoritative charge amount server-side. Never trust a client-sent total.
PRODUCT_SERVICE_URL=http://localhost:3002

# Stripe — secret key stays server-side only, never send it to the frontend.
# STRIPE_SECRET_KEY=sk_test_your_secret_key
# From the Stripe CLI (`stripe listen --forward-to localhost:3005/api/payments/webhook`)
# in development, or the Dashboard's webhook endpoint settings in production.
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret


GOOGLE_CLIENT_ID=your_google_client_id
# ─── Stripe (payment-service) ──────────────────────────────────────────────
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
