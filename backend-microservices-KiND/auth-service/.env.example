PORT=3001
MONGO_URI=mongodb://localhost:27017/auth-service
RABBITMQ_URL=amqp://localhost

# Set to "production" once this is actually served over HTTPS — required for the refresh
# token cookie's `secure` flag to turn on (see utils/cookies.js). Leave unset/anything else
# for local dev over plain http://, or the cookie silently won't be sent at all.
NODE_ENV=development

# Comma-separated list of frontend origins allowed to send credentialed requests here
# (needed for the refresh-token cookie to work at all — see index.js).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=30
RESET_TOKEN_EXPIRES_MINUTES=30

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Dev/test-only — see adminRegister's comment in controllers/authController.js. Leave unset
# to keep that endpoint fully disabled (the default).
ADMIN_REGISTRATION_CODE=
